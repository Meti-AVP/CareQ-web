{
  "name": "carq-web",
  "private": true,
  "version": "1.0.0",
  "description": "CarQ web surfaces — Admin dashboard + Dealers (exhibitions) portal",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:admin": "npm run dev --workspace=@carq/admin",
    "dev:dealers": "npm run dev --workspace=@carq/dealers",
    "start:admin": "npm run start --workspace=@carq/admin",
    "start:dealers": "npm run start --workspace=@carq/dealers",
    "build": "npm run build --workspace=@carq/admin && npm run build --workspace=@carq/dealers",
    "build:admin": "npm run build --workspace=@carq/admin",
    "build:dealers": "npm run build --workspace=@carq/dealers",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "checks": "node scripts/static-checks.mjs",
    "verify": "node scripts/verify.mjs",
    "e2e": "playwright test",
    "e2e:report": "playwright show-report e2e/report"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.25",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=20"
  }
}
