# ════════════════════════════════════════════════════════════════
# متغيرات البيئة — carq-web (المرحلة ٥)
#
# انسخ الملف ده لـ.env.local جوه apps/admin و apps/dealers (كل تطبيق
# له نسخة مستقلة — .env.local عمره ما بيتضاف للـgit). القيم هنا أمثلة
# بس، مفيش سر حقيقي في الملف ده.
# ════════════════════════════════════════════════════════════════

# عنوان الباك اند الحقيقي. سيبه فاضي (أو امسح السطر) عشان التطبيق يفضل
# شغّال على وضع الموك بالكامل — مفيد للعرض والتطوير قبل ما الباك يجهز.
# أول ما يتحط، USE_MOCK بيبقى false لوحده في كل حزمة packages/api-client —
# مفيش شاشة أو hook محتاج يتعدّل (packages/api-client/src/client.ts).
NEXT_PUBLIC_API_URL=

# عنوان تخزين الصور/الملفات الموقّعة (لو على دومين منفصل عن الباك اند) —
# بيدخل img-src في CSP تلقائي (security-headers.mjs). سيبه فاضي لو نفس
# دومين NEXT_PUBLIC_API_URL أو لو مفيش باك اند لسه.
NEXT_PUBLIC_STORAGE_URL=

# وضع الديمو — بوابة الدخول الوهمي (أي رقم مصري صحيح + أي كود دخول
# بيعدّي، docs/AUTH.md §٢). شغّال بس لو USE_MOCK شغّال (NEXT_PUBLIC_API_URL
# فاضي) *و* المتغيّر ده مش متحط صراحة بـ"false". اتركه فاضي في التطوير
# المحلي العادي — الديمو هيشتغل تلقائي طول ما مفيش باك اند. لو عايز تقفل
# الديمو حتى في بيئة موك مشتركة (staging مثلًا)، حطه "false" صراحة.
NEXT_PUBLIC_DEMO_MODE=

# الدخول بجوجل — خيار إضافي جنب كود OTP، مش بدل منه (docs/AUTH.md §7).
# لازم الاتنين مع بعض عشان الزرار يشتغل. مفيش قيمة "NEXT_PUBLIC_" —
# دول سيرفر بس، عمرهم ما يوصلوا للمتصفح (client_secret بالذات).
#
# خطوات إنشائهم من Google Cloud Console:
#   ١) https://console.cloud.google.com/apis/credentials — اعمل مشروع
#      جديد (أو استخدم موجود)، وفعّل "Google Identity" / "OAuth consent
#      screen" الأول (External، وحط اسم التطبيق + إيميلك).
#   ٢) "Create Credentials" → "OAuth client ID" → نوعه "Web application".
#   ٣) في "Authorized redirect URIs" ضيف بالظبط (المنفذين الاتنين):
#        http://localhost:3100/api/auth/google/callback   (أدمن)
#        http://localhost:3200/api/auth/google/callback   (معارض)
#      وفي الإنتاج بعدين: https://admin.carq.eg/api/auth/google/callback
#      و https://dealers.carq.eg/api/auth/google/callback
#   ٤) انسخ الـ"Client ID" والـ"Client secret" هنا تحت.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# رصد أخطاء الإنتاج — Sentry (المرحلة ٨ بند ٥). بلا الاتنين، الـSDK
# بيتحمّل عادي بس مبيبعتش أي حاجة — نفس مبدأ المرونة بتاع جوجل أوث فوق.
# الاتنين لازم يبقوا نفس القيمة (الكلاينت محتاج نسخة NEXT_PUBLIC_ عشان
# الأخطاء اللي بتحصل في المتصفح نفسه، مش بس في السيرفر).
#   ١) اعمل حساب/مشروع على https://sentry.io (فيه خطة مجانية).
#   ٢) Settings → Projects → (مشروعك) → Client Keys (DSN) — انسخ الرابط.
# ممنوع نبعت أرقام تليفونات/صور بطاقات/توكنز في أي تقرير خطأ — مطبّق
# في `src/lib/sentry-shared.ts` (كل تطبيق) بـ`beforeSend` + `sendDefaultPii: false`.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ────────────────────────────────────────────────────────────────
# أدوات تطوير — مش للإنتاج
# ────────────────────────────────────────────────────────────────

# منفذ سيرفر الاختبار المحلي (scripts/mock-backend.mjs) — افتراضي ٤٠٠٠.
# شغّله بـ`npm run mock-backend` واحط NEXT_PUBLIC_API_URL=http://localhost:4000
# عشان تختبر التبديل فعليًا (تفاصيل في docs/BACKEND-CONTRACT.md §٨).
# PORT=4000
